#!/usr/bin/env bash
# Explicit host setup, not part of Home Manager activation or dotfiles reload.
set -euo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
register=true
case "${1:-}" in
'') ;;
--no-register) register=false ;;
*)
  echo 'Usage: install-myran-editor [--no-register]' >&2
  exit 2
  ;;
esac
if [[ $# -gt 1 ]]; then
  echo 'Usage: install-myran-editor [--no-register]' >&2
  exit 2
fi
if [[ $(uname -s) != Darwin || ${HOME:-} != /* ]]; then
  echo 'Myran Editor requires macOS, an absolute HOME, and the Xcode command line tools.' >&2
  exit 1
fi
app="$HOME/Applications/Myran Editor.app"
# The resource launcher is intentionally a symlink. Installed directories and files are not.
for path in "$HOME" "$HOME/Applications" "$app" "$app/Contents" \
  "$app/Contents/MacOS" "$app/Contents/Resources" \
  "$app/Contents/MacOS/myran-editor" "$app/Contents/Info.plist"; do
  if [[ -L "$path" ]]; then
    printf 'Refusing a symlink installation path: %s\n' "$path" >&2
    exit 1
  fi
done
if [[ -e "$app" ]] && [[ $(/usr/bin/plutil -extract CFBundleIdentifier raw "$app/Contents/Info.plist") != io.github.mitander.myran-editor ]]; then
  echo "Refusing to replace an unrelated app: $app" >&2
  exit 1
fi
for path in "$app/Contents/MacOS/myran-editor" "$app/Contents/Info.plist" "$app/Contents/Resources/myran-open-files"; do
  if [[ -e "$path" && ! -f "$path" && ! -L "$path" ]]; then
    printf 'Refusing to replace a non-file installation target: %s\n' "$path" >&2
    exit 1
  fi
done
# Stage beside the app so replacing a running executable is an atomic rename, never a truncation.
mkdir -p "$HOME/Applications"
build=$(mktemp -d "$HOME/Applications/.myran-editor.XXXXXX")
trap 'rm -rf "$build"' EXIT
mkdir -p "$build/Contents/MacOS"
/usr/bin/swiftc -target "$(uname -m)-apple-macosx13.0" "$ROOT/extras/myran-editor/FileLinks.swift" "$ROOT/extras/myran-editor/Launcher.swift" "$ROOT/extras/myran-editor/main.swift" -o "$build/Contents/MacOS/myran-editor"
cp "$ROOT/extras/myran-editor/Info.plist" "$build/Contents/Info.plist"
mkdir -p "$app/Contents/"{MacOS,Resources}
mv -f "$build/Contents/MacOS/myran-editor" "$app/Contents/MacOS/myran-editor"
mv -f "$build/Contents/Info.plist" "$app/Contents/Info.plist"
ln -sfn "$ROOT/scripts/myran-open-files" "$app/Contents/Resources/myran-open-files"
if "$register"; then
  "$app/Contents/MacOS/myran-editor" --register-app
fi
printf 'Installed %s\nNo default-setting requests were made. Choose Myran Editor in Finder for text files.\n' "$app"
