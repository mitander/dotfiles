# Refuse guessed identities when machine-local settings are missing.
[user]
	useConfigOnly = true

[core]
	editor = nvim

# Command defaults
[diff]
	renames = copies

[fetch]
	prune = true

[push]
	default = simple

[init]
	defaultBranch = master

# Colors and diffs
[color]
	branch = auto
	diff = auto
	interactive = auto
	status = auto
	ui = auto

[color "status"]
	added = green
	changed = red bold
	untracked = magenta bold

[pager]
	diff = delta
	log = delta
	reflog = delta
	show = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	features = flume
	navigate = true
	side-by-side = true

	line-numbers-left-format = "{nm:^4} "
	line-numbers-right-format = "{np:^4} "

[include]
	path = ~/.local/share/nvim/flume/current/delta.gitconfig

# Credentials and integrations
[credential]
	helper = store

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# Keep identities and repository-specific settings machine-local.
[include]
	path = ~/.config/git/local.gitconfig
