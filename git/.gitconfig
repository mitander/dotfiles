[user]
	email = carlmitander@gmail.com
	name = mitander
[core]
	editor = nvim
[credential]
	helper = store
[color]
	branch = auto
	diff = auto
	interactive = auto
	status = auto
	ui = auto
[color "status"]
	added = green
	changed = red bold
	untracked = magenta bold
[diff]
	renames = copies
[fetch]
	prune = true
[push]
	default = simple
[init]
	defaultBranch = master

[pager]
	diff = delta
	log = delta
	reflog = delta
	show = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	features = flume
	navigate = true
	side-by-side = true

	line-numbers-left-format = "{nm:^4} "
	line-numbers-right-format = "{np:^4} "

[include]
	path = ~/dotfiles/themes/flume/extras/current/delta.gitconfig

[coderabbit]
	machineId = cli/1cb8ea8a75fb415690b82f20894d94d3
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# Personal identity must follow work because ~/c/p is inside ~/c.
[includeIf "gitdir:~/c/"]
	path = ~/.config/git/work.gitconfig
[includeIf "gitdir:~/c/p/"]
	path = ~/.config/git/personal.gitconfig

[include]
	path = ~/.config/git/local.gitconfig
