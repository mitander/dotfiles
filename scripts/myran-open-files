#!/usr/bin/env bash
# Called by the macOS document app, without a terminal's environment.
set -euo pipefail

# Finder does not supply a terminal's PATH or a reliable tmux caller identity.
export PATH="$HOME/.local/bin:$HOME/.nix-profile/bin:/opt/homebrew/bin:/usr/bin:/bin"
unset TMUX TMUX_PANE MYRAN_TMUX_SERVER_ID MYRAN_TMUX_CLIENT \
  MYRAN_TMUX_CLIENT_PID MYRAN_TMUX_PANE_PID MYRAN_TMUX_RUN_GENERATION

# Validate location syntax and every document before choosing a workspace.
location=''
if [[ ${1:-} == --at ]]; then
  if [[ $# != 4 || ${3:-} != -- || ! ${2:-} =~ ^[0-9]+(-[0-9]+)?$ ]]; then
    echo 'Expected --at LINE[-END] -- /absolute/file.' >&2
    exit 1
  fi
  location=$2
  shift 3
fi

if [[ $# == 0 ]]; then
  echo 'Open a text file with Myran Editor from Finder or a file:// link.' >&2
  exit 1
fi
for path in "$@"; do
  if [[ "$path" != /* || ! -f "$path" ]]; then
    printf 'Not a local regular file: %s\n' "$path" >&2
    exit 1
  fi
done

# Capture the hidden server capability with the pane, never a Session-shadowed variable.
# This bridge reads existing authority. It must not initialize or renew a server identity.
identity='#{V/g:#{?#{&&:#{==:#{environ_name},_MYRAN_SERVER_ID},#{==:#{environ_hidden},1}},#{environ_value},}}'
scope_format="#{socket_path},#{pid},0@$identity"
clients=$(tmux -N list-clients -F "#{client_activity} #{client_pid} #{pane_id} $scope_format")
latest=$(printf '%s\n' "$clients" | sort -nr)
latest=${latest%%$'\n'*}
read -r activity client pane captured <<<"$latest"
scope=${captured%@*}
token=${captured##*@}
if [[ ! "$activity" =~ ^[0-9]+$ || ! "$client" =~ ^[0-9]+$ || ! "$pane" =~ ^%[0-9]+$ || ! "$scope" =~ ^/.*,[0-9]+,0$ || ! "$token" =~ ^v1-[0-9a-f]{32}$ ]]; then
  echo 'Myran Editor needs an attached tmux client with a valid Myran server identity.' >&2
  exit 1
fi

# Recheck the complete captured identity, including a changed token at the same socket/PID.
observed=$(tmux -N display-message -p -t "$pane" "$scope_format")
if [[ "$observed" != "$captured" ]]; then
  echo 'The tmux server changed while opening the file. Click the link again.' >&2
  exit 1
fi
TMUX=$scope
TMUX_PANE=$pane
MYRAN_TMUX_SERVER_ID=$token
export TMUX TMUX_PANE MYRAN_TMUX_SERVER_ID

root=$(tmux -N show-options -qv -t "$pane" @workspace_root)
if [[ "$root" != /* || ! -d "$root" ]]; then
  echo 'The active tmux client is not in a Myran workspace.' >&2
  exit 1
fi

# Hand off in the selected workspace, preserving literal document arguments.
cd -- "$root"
if [[ -n "$location" ]]; then
  exec myran open-at "$location" -- "$@"
fi
exec myran open -- "$@"
