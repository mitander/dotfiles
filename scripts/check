#!/usr/bin/env bash
# The default gate needs no installed plugins, Myran binary, credentials or live session.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
export PYTHONDONTWRITEBYTECODE=1

case "${1:-}" in
'')
  # Check source style and both Python platforms before behavior tests.
  sh scripts/format.sh check
  pyright --project pyrightconfig.json --pythonplatform Darwin
  pyright --project pyrightconfig.json --pythonplatform Linux

  # Exercise installation, command routing and editor behavior in isolated fixtures.
  python3 tests/install-myran.py
  python3 tests/loc-tree.py
  node --experimental-strip-types --test tests/pi-shell-file-links.ts
  for test in dotfiles-command tracker-local fish-config fish-nvim myran-open-files myran-yazi tmux-run-borders; do
    bash "tests/$test.sh"
  done
  for test in nvim-config nvim-performance nvim-formatters nvim-clipboard nvim-files nvim-preview; do
    nvim --clean --headless -l "tests/$test.lua"
  done
  ;;
myran)
  # Test installed Myran against private tmux servers only.
  bash tests/tmux-config.sh
  ;;
pi)
  node tests/pi-native.mjs
  ;;
myran-editor)
  # Use disposable apps and HOME without selecting host document defaults.
  bash tests/myran-editor-macos.sh
  bash tests/myran-editor-install-macos.sh
  ;;
yazi)
  # Exercise pinned Yazi with private tmux, config and recording application openers.
  bash tests/yazi-native.sh
  ;;
fzf)
  nvim --clean --headless -l tests/nvim-fzf.lua
  ;;
nvim-startup)
  # Exercise installed plugins with isolated config/state and no language-server processes.
  nvim --clean --headless -l tests/nvim-startup.lua
  ;;
luals)
  # Check the real language server and prove undefined-name diagnostics stay enabled.
  nvim --clean --headless -l tests/nvim-luals.lua
  ;;
files)
  # Exercise both pinned file browsers with disposable files and windows.
  plugins="${XDG_DATA_HOME:-$HOME/.local/share}/nvim/lazy"
  nvim --clean --headless -l tests/nvim-files.lua \
    "${NVIM_OIL_DIR:-$plugins/oil.nvim}" "${NVIM_TREE_DIR:-$plugins/nvim-tree.lua}" "${NVIM_LUALINE_DIR:-$plugins/lualine.nvim}"
  ;;
preview)
  # Exercise the pinned preview plugin with disposable loopback connections.
  plugin="${NVIM_LIVE_PREVIEW_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/nvim/lazy/live-preview.nvim}"
  nvim --clean --headless -l tests/nvim-preview.lua "$plugin"
  ;;
formatters)
  # Test installed Conform with real formatting tools.
  nvim --clean --headless -l tests/nvim-dprint.lua
  ;;
trackers)
  # Run the editable checkout's checks in its own Python environment.
  checkout="${LTUI_CHECKOUT:-$HOME/c/p/ltui}"
  "$checkout/.venv/bin/python" tests/tracker-editable.py "$checkout"
  FLUME_RUNTIME="${DOTFILES_DIR:-$HOME/dotfiles}/themes/flume" \
    PYTHON="$checkout/.venv/bin/python" "$checkout/scripts/check"
  ;;
*)
  printf 'Usage: scripts/check [myran|myran-editor|yazi|pi|fzf|nvim-startup|luals|files|preview|formatters|trackers]\n' >&2
  exit 2
  ;;
esac
